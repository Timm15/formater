{
  "name": "Formater — конвертер файлов",
  "short_name": "Formater",
  "description": "Конвертирует, сжимает и обрезает фото, видео, аудио, PDF и документы прямо на устройстве. Файлы никуда не отправляются.",
  "lang": "ru",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eceff3",
  "theme_color": "#2448d8",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "files": [{ "name": "files", "accept": ["image/*", "video/*", "audio/*", "application/pdf", ".pdf", ".docx", ".xlsx", ".xls", ".ods", ".csv", ".json", ".md", ".html", ".txt", ".heic"] }]
    }
  }
}
